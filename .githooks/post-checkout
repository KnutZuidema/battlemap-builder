#!/bin/sh
# Point a fresh worktree at the machine-local shared cargo target dir (curator).
#
# Without it every worktree compiles the whole dependency tree from scratch and keeps
# its own multi-GB curator/target. When this machine has the shared cache
# (CURATOR_SHARED_TARGET_DIR, default ~/.omp/targets/curator), the new worktree gets an
# untracked .cargo/config.toml that points there. Machines without that directory are
# left alone, and CI never runs this hook.
set -u

shared="${CURATOR_SHARED_TARGET_DIR:-${HOME:-}/.omp/targets/curator}"
[ -d "$shared" ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$root" ] || exit 0

cfg="$root/.cargo/config.toml"
[ -e "$cfg" ] && exit 0

mkdir -p "$root/.cargo" || exit 0
cat > "$cfg" <<EOF && echo "curator: shared cargo target dir -> $shared" >&2
# Machine-local build cache: one cargo target dir shared by every worktree of this repo.
# Generated by .githooks/post-checkout; delete this file to opt out.
[build]
target-dir = "$shared"
EOF

exit 0
