# Curator server configuration
PORT=3002
DATA_DIR=data

# Reddit API OAuth2 configuration (recommended to avoid HTTP 403 Forbidden errors)
# Option 1: OAuth refresh token authentication (user grant)
# REDDIT_CLIENT_ID is optional when REDDIT_REFRESH_TOKEN is set (defaults to public client ID: TWTsqXa53CexlrYGBWaesQ).
# REDDIT_REFRESH_TOKEN=your_reddit_refresh_token_here
# REDDIT_CLIENT_ID=your_reddit_client_id_here

# Option 2: Script app client credentials
# Create a script app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id_here
# REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Custom User-Agent header (format: <platform>:<app ID>:<version string> (by /u/<reddit username>))
# Note: Must be enclosed in double quotes if it contains spaces or parentheses
# REDDIT_USER_AGENT="DungeonForge-Curator/1.0 (by /u/your_reddit_username)"

# Optional endpoint overrides (e.g. for mock testing or proxies)
# REDDIT_BASE_URL=https://www.reddit.com
# REDDIT_OAUTH_BASE_URL=https://oauth.reddit.com
# REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token

# Optional rate limit backoff configuration (HTTP 429 handling)
# REDDIT_BACKOFF_INITIAL_SECS=3
# REDDIT_BACKOFF_MAX_RETRIES=5
# REDDIT_BACKOFF_FACTOR=2.0
