# Curator server configuration
PORT=3002
DATA_DIR=data

# Reddit API OAuth2 configuration (recommended to avoid HTTP 403 Forbidden errors)
# Create a script app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id_here
# REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Custom User-Agent header (format: <platform>:<app ID>:<version string> (by /u/<reddit username>))
# REDDIT_USER_AGENT=DungeonForge-Curator/1.0 (by /u/your_reddit_username)

# Optional endpoint overrides (e.g. for mock testing or proxies)
# REDDIT_BASE_URL=https://www.reddit.com
# REDDIT_OAUTH_BASE_URL=https://oauth.reddit.com
# REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
