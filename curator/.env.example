# Curator server configuration
PORT=3002
DATA_DIR=data

# OpenRouter API (Benchmark runs, vision model suggestions & physical descriptions)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face User Access Token (Gated Base Model: black-forest-labs/flux-3-image-klein-base)
HF_TOKEN=your_huggingface_token_here

# Modal Cloud GPU Training Runner (ai-toolkit on L40S 48GB tier)
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here
CURATOR_MODAL_ENDPOINT=https://your-org--curator-training-runner-app.modal.run
CURATOR_MODAL_TOKEN=your_modal_runner_bearer_token_here

# Cloudflare R2 Object Storage (Dataset Snapshots, LoRA Adapters, Checkpoint Samples)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=dungeonforge-artifacts
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_bucket_hash.r2.dev

# WaveSpeedAI Serverless LoRA Inference (FLUX 3 Klein text-to-image and edit LoRA)
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# Reddit API OAuth2 configuration (recommended to avoid HTTP 403 Forbidden errors)
# Option 1: OAuth refresh token authentication (user grant)
# REDDIT_CLIENT_ID is optional when REDDIT_REFRESH_TOKEN is set (defaults to public client ID: TWTsqXa53CexlrYGBWaesQ).
# REDDIT_REFRESH_TOKEN=your_reddit_refresh_token_here
# REDDIT_CLIENT_ID=your_reddit_client_id_here

# Option 2: Script app client credentials
# Create a script app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id_here
# REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Custom User-Agent header (format: <platform>:<app ID>:<version string> (by /u/<reddit username>))
# Note: Must be enclosed in double quotes if it contains spaces or parentheses
# REDDIT_USER_AGENT="DungeonForge-Curator/1.0 (by /u/your_reddit_username)"

# Optional endpoint overrides (e.g. for mock testing or proxies)
# REDDIT_BASE_URL=https://www.reddit.com
# REDDIT_OAUTH_BASE_URL=https://oauth.reddit.com
# REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token

# Optional rate limit backoff configuration (HTTP 429 handling)
# REDDIT_BACKOFF_INITIAL_SECS=3
# REDDIT_BACKOFF_MAX_RETRIES=5
# REDDIT_BACKOFF_FACTOR=2.0
