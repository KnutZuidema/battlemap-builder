set shell := ["bash", "-uc"]


# Run the interactive credentials setup wizard
provision-secrets:
    ../../scripts/provision-credentials.sh
# Apply all manifests and wait for rollout
deploy:
    kubectl apply -f namespace.yaml
    kubectl apply -f pvc.yaml
    if [ -f secret.yaml ]; then kubectl apply -f secret.yaml; fi
    kubectl apply -f deployment.yaml
    kubectl apply -f service.yaml
    kubectl rollout status deployment/curator -n curator

# View resource status
status:
    kubectl get all,pvc -n curator

# View pod logs
logs:
    kubectl logs -n curator deployment/curator

# Follow pod logs
tail-logs:
    kubectl logs -n curator deployment/curator -f

# Port-forward curator service to localhost:3002
port-forward:
    kubectl port-forward service/curator 3002:3002 -n curator


# Run disk-to-S3 storage migration inside running pod
migrate-storage:
    kubectl exec -it -n curator deployment/curator -- curator migrate-disk-to-s3

# Dry-run disk-to-S3 storage migration inside running pod
migrate-storage-dry-run:
    kubectl exec -it -n curator deployment/curator -- curator migrate-disk-to-s3 --dry-run

# Run disk-to-S3 storage migration as a standalone Kubernetes Job (Option B)
migrate-storage-job:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Scaling down deployment/curator to release ReadWriteOnce volume..."
    kubectl scale deployment curator -n curator --replicas=0
    cleanup() {
        echo "Restoring deployment/curator replicas to 1..."
        kubectl scale deployment curator -n curator --replicas=1
        kubectl rollout status deployment/curator -n curator --timeout=180s
    }
    trap cleanup EXIT
    kubectl delete job curator-storage-migration -n curator --ignore-not-found
    echo "Submitting migration Job..."
    kubectl apply -f job-migrate-storage.yaml
    kubectl wait --for=condition=complete job/curator-storage-migration -n curator --timeout=300s
    kubectl logs -n curator job/curator-storage-migration
    kubectl delete job curator-storage-migration -n curator

# Run disk-to-PostgreSQL catalog migration inside running pod
migrate-catalog:
    kubectl exec -it -n curator deployment/curator -- curator migrate-disk-to-postgres

# Dry-run disk-to-PostgreSQL catalog migration inside running pod
migrate-catalog-dry-run:
    kubectl exec -it -n curator deployment/curator -- curator migrate-disk-to-postgres --dry-run

# Run disk-to-PostgreSQL catalog migration as a standalone Kubernetes Job
migrate-catalog-job:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Scaling down deployment/curator to release ReadWriteOnce volume..."
    kubectl scale deployment curator -n curator --replicas=0
    cleanup() {
        echo "Restoring deployment/curator replicas to 1..."
        kubectl scale deployment curator -n curator --replicas=1
        kubectl rollout status deployment/curator -n curator --timeout=180s
    }
    trap cleanup EXIT
    kubectl delete job curator-catalog-migration -n curator --ignore-not-found
    echo "Submitting catalog migration Job..."
    kubectl apply -f job-migrate-catalog.yaml
    kubectl wait --for=condition=complete job/curator-catalog-migration -n curator --timeout=300s
    kubectl logs -n curator job/curator-catalog-migration
    kubectl delete job curator-catalog-migration -n curator

# Delete deployed manifests
delete:
    kubectl delete -f service.yaml --ignore-not-found
    kubectl delete -f deployment.yaml --ignore-not-found
    kubectl delete -f pvc.yaml --ignore-not-found
    kubectl delete -f namespace.yaml --ignore-not-found
