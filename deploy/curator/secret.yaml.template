apiVersion: v1
kind: Secret
metadata:
  name: curator-secrets
  namespace: curator
  labels:
    app: curator
    app.kubernetes.io/name: curator
type: Opaque
stringData:
  OPENROUTER_API_KEY: "your_openrouter_api_key_here"
  REDDIT_CLIENT_ID: "your_reddit_client_id_here"
  REDDIT_CLIENT_SECRET: "your_reddit_client_secret_here"
  REDDIT_REFRESH_TOKEN: "your_reddit_refresh_token_here"
  REDDIT_USER_AGENT: "DungeonForge-Curator/1.0 (by /u/your_reddit_username)"
