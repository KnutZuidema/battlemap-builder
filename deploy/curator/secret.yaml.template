apiVersion: v1
kind: Secret
metadata:
  name: curator-secrets
  namespace: curator
  labels:
    app: curator
    app.kubernetes.io/name: curator
type: Opaque
stringData:
  DATABASE_URL: "postgres://your_db_user:your_db_password@your_postgres_host:5432/curator"
  OPENROUTER_API_KEY: "your_openrouter_api_key_here"
  HF_TOKEN: "your_huggingface_token_here"
  MODAL_TOKEN_ID: "your_modal_token_id_here"
  MODAL_TOKEN_SECRET: "your_modal_token_secret_here"
  CURATOR_MODAL_ENDPOINT: "https://your-org--curator-training-runner-app.modal.run"
  CURATOR_MODAL_TOKEN: "your_modal_runner_bearer_token_here"
  R2_ACCOUNT_ID: "your_cloudflare_account_id_here"
  R2_ACCESS_KEY_ID: "your_r2_access_key_id_here"
  R2_SECRET_ACCESS_KEY: "your_r2_secret_access_key_here"
  R2_BUCKET_NAME: "dungeonforge-artifacts"
  R2_ENDPOINT: "https://your_account_id.r2.cloudflarestorage.com"
  R2_PUBLIC_URL: "https://pub-your_bucket_hash.r2.dev"
  WAVESPEED_API_KEY: "your_wavespeed_api_key_here"
  REDDIT_CLIENT_ID: "your_reddit_client_id_here"
  REDDIT_CLIENT_SECRET: "your_reddit_client_secret_here"
  REDDIT_REFRESH_TOKEN: "your_reddit_refresh_token_here"
  REDDIT_USER_AGENT: "DungeonForge-Curator/1.0 (by /u/your_reddit_username)"
