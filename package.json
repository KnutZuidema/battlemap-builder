{
  "name": "dungeon-forge-battlemap-builder",
  "version": "1.0.0",
  "description": "Interactive TTRPG Battlemap Builder with selectable OpenRouter image models and grid-snapped region forging",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"amber,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/index.js",
    "test": "npm --prefix server test",
    "lint": "npm --prefix client run lint",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "curator": "cargo run --manifest-path curator/Cargo.toml --release",
    "curator:dev": "cargo run --manifest-path curator/Cargo.toml",
    "prototype:training": "python3 -m http.server 3003 --directory curator/src/ui/assets"
  },
  "keywords": [
    "ttrpg",
    "dnd",
    "battlemap",
    "openrouter",
    "ai",
    "region-forging"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
